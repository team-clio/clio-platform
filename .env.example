POSTGRES_DB=clio
POSTGRES_USER=clio
POSTGRES_PASSWORD=clio

CLIO_ADMIN_PORT=3000
CLIO_SERVER_PORT=8080
CLIO_POSTGRES_PORT=15432
CLIO_DDL_AUTO=update

# Full profile: Agent Graph
CLIO_AGENT_GRAPH_PORT=2024
CLIO_PCM_POSTGRES_PORT=55432
CLIO_PCM_POSTGRES_DB=clio_pcm
CLIO_PCM_POSTGRES_USER=clio
CLIO_PCM_POSTGRES_PASSWORD=clio_dev_password
CLIO_OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Live LLM execution. Keep the real key only in your untracked .env file.
CLIO_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
CLIO_MODEL_BASE_URL=
CLIO_MODEL_API_KEY_ENV=
CLIO_MODEL_EXTRA_BODY=
